# ==============================================================================
# COMPASS v2.0.0 — Operational Environment Configuration Template
# ==============================================================================
# All settings default to safe, local-first operation.
# DO NOT COMMIT SECRET KEYS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application & Environment
COMPASS_APP_NAME=COMPASS
COMPASS_APP_VERSION=2.0.0
COMPASS_ENVIRONMENT=development
COMPASS_DEBUG=false

# Network Binding (Strict loopback isolation)
COMPASS_HOST=127.0.0.1
COMPASS_PORT=8000
COMPASS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Storage & Persistence Paths (Relative to project root or absolute)
COMPASS_STORAGE_DIR=storage
COMPASS_DATABASE_PATH=storage/compass.db
COMPASS_CAPTURES_DIR=storage/captures

# Logging & Telemetry
COMPASS_LOGS_DIR=logs
COMPASS_LOG_FILE=logs/compass.log
COMPASS_LOG_LEVEL=INFO
COMPASS_MAX_EVIDENCE_HISTORY=50

# UI Overlay HUD
COMPASS_OVERLAY_ENABLED=true
COMPASS_OVERLAY_CLICK_THROUGH=true

# Windows UI Automation & Perception Limits
COMPASS_UIA_MAX_DEPTH=3
COMPASS_UIA_MAX_ELEMENTS=200
COMPASS_UIA_TIMEOUT_SEC=5.0
COMPASS_PERCEPTION_POLL_INTERVAL_SEC=0.5
COMPASS_ACTION_FOREGROUND_CHECK=true

# Resource Limits & Safety Circuit Breaker
COMPASS_CIRCUIT_FAILURE_THRESHOLD=5
COMPASS_CIRCUIT_RECOVERY_S=30.0
COMPASS_MAX_RAM_BUDGET_MB=2048
COMPASS_MAX_VRAM_BUDGET_MB=1024
COMPASS_MAX_OCR_TIMEOUT_SEC=5.0
COMPASS_MAX_SCREENSHOT_RETENTION=20

# Local AI Reasoning (Default: Rule-based & Local Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:latest
COMPASS_LLM_TIMEOUT=30.0

# Optional External Cloud LLM Providers (Disabled by default; leave blank for 100% offline local operation)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
